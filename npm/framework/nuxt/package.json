{
  "name": "@vizejs/nuxt",
  "version": "0.404.2",
  "description": "Nuxt module for Vize - compiler, musea gallery, linter, and type checker",
  "keywords": [
    "compiler",
    "gallery",
    "linter",
    "musea",
    "nuxt",
    "nuxt-module",
    "type-checker",
    "vize",
    "vue"
  ],
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "author": "ubugeeei",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize.git",
    "directory": "npm/framework/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/nuxt2-entry.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/nuxt2-entry.cjs",
      "default": "./dist/index.mjs"
    },
    "./lint": {
      "types": "./dist/lint/index.d.mts",
      "import": "./dist/lint/index.mjs",
      "default": "./dist/lint/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "pnpm --filter @vizejs/nuxt-lint-config build && pnpm build && node --test src/*.test.ts src/**/*.test.ts src/lint/checker/*.test.ts",
    "check": "vp check src vite.config.ts",
    "check:fix": "vp check --fix src vite.config.ts",
    "fmt": "vp fmt --write src vite.config.ts"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:nuxt-module",
    "@vizejs/native": "workspace:*",
    "@vizejs/nuxt-lint-config": "workspace:*",
    "@vizejs/vite-plugin": "workspace:*",
    "@vizejs/vite-plugin-musea": "workspace:*",
    "oxlint-plugin-vize": "workspace:*",
    "vize": "workspace:*"
  },
  "devDependencies": {
    "jiti-nuxt2": "npm:jiti@1.21.7",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite-stack",
    "vite-plus": "catalog:vite-stack",
    "vue": "catalog:vue-stable",
    "vue-router": "catalog:vue-stable"
  },
  "peerDependencies": {
    "nuxt": "^2.16.0 || ^3.0.0 || ^4.0.0",
    "oxlint": "^1.64.0",
    "vite": "^7.3.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
