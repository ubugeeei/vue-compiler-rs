{
  "schemaVersion": 1,
  "trackingIssue": 3224,
  "baseline": {
    "name": "vuejs/language-tools",
    "server": "Vue Language Server",
    "contract": "Vize must match or exceed the editor-visible Vue Language Server protocol surface for the listed feature dimensions. Each dimension has positive and negative oracles that are enforced by executable tests, not by this artifact alone.",
    "versionEvidence": [
      {
        "file": "pnpm-workspace.yaml",
        "contains": ["vue-tsc: \"3.3.4\"", "typescript: \"6.0.3\""]
      },
      {
        "file": "tests/package.json",
        "contains": ["\"vue-tsc\": \"catalog:typescript\""]
      }
    ]
  },
  "featureMatrix": [
    {
      "dimension": "diagnostics",
      "lspMethods": ["textDocument/publishDiagnostics"],
      "mustInclude": [
        {
          "id": "authored-type-diagnostic",
          "summary": "TS2322 prop and template mismatches publish on the authored Vue range.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-typecheck-template.test.ts",
              "contains": ["Type 'string' is not assignable to type 'number'.", "bindingStart"]
            },
            {
              "file": "editors/vscode/test/suite/real-scenario-expected.cjs",
              "contains": ["source: \"vize/types\"", "range: [7, 9, 7, 14]"]
            }
          ]
        },
        {
          "id": "lint-diagnostic-authored-span",
          "summary": "Fixable lint diagnostics publish on the authored gap, with code descriptions.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-code-action-kinds.test.ts",
              "contains": ["vue/no-multi-spaces", "sfcRange"]
            }
          ]
        }
      ],
      "mustExclude": [
        {
          "id": "stale-repaired-diagnostics",
          "summary": "Repaired buffers and clean documents do not retain stale diagnostics.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-diagnostics-lifecycle.test.ts",
              "contains": [
                "didClose clears diagnostics",
                "assert.deepEqual(closePublish.diagnostics, [])"
              ]
            },
            {
              "file": "editors/vscode/test/suite/extension-host-real.cjs",
              "contains": ["repairedDiagnostics", "assert.deepEqual(diagnostics, [])"]
            }
          ]
        }
      ]
    },
    {
      "dimension": "completion",
      "lspMethods": ["textDocument/completion"],
      "mustInclude": [
        {
          "id": "template-expression-bindings",
          "summary": "Template expression completion includes script/setup bindings.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-authoring-core.test.ts",
              "contains": [
                "completionItems.includes(\"count\")",
                "!completionItems.includes(\"v-if\")"
              ]
            },
            {
              "file": "tests/tooling/lsp-template-completion.test.ts",
              "contains": [
                "component prop completion tracks unsaved child edits",
                "labels.includes(\"disabled\")"
              ]
            }
          ]
        }
      ],
      "mustExclude": [
        {
          "id": "context-leakage",
          "summary": "Expression, attribute, directive, and comment contexts reject unrelated labels.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-editor-production-gates.test.ts",
              "contains": ["!labels.includes(\"v-if\")", "!labels.includes(\"count\")"]
            },
            {
              "file": "tests/tooling/lsp-template-completion.test.ts",
              "contains": ["!labels.includes(\"disk-only\")", "!labels.includes(\"Transition\")"]
            }
          ]
        }
      ]
    },
    {
      "dimension": "signature-help",
      "lspMethods": ["textDocument/signatureHelp"],
      "mustInclude": [
        {
          "id": "template-call-signature",
          "summary": "Template interpolation calls return TypeScript signature help on authored Vue positions.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-signature-help-capability.test.ts",
              "contains": [
                "vize lsp maps textDocument/signatureHelp from authored SFC template calls",
                "signature help should answer the authored template call",
                "precision: number"
              ]
            }
          ]
        }
      ],
      "mustExclude": [
        {
          "id": "non-call-position",
          "summary": "Authored positions outside callable expressions return null instead of stale signature help.",
          "evidence": [
            {
              "file": "tests/tooling/lsp-signature-help-capability.test.ts",
              "contains": [
                "nonCallHelp",
                "signature help must not answer outside a callable authored expression"
              ]
            }
          ]
        }
      ]
    },
    {
      "dimension": "hover",
      "lspMethods": ["textDocument/hover"],
      "mustInclude": [
